STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# ── Crypto payment (BTCPay Server) ────────────────────────────────────────────
# Leeg laten = crypto-provider wordt NIET geladen (backend boot met enkel system/manual).
# Vul ALLE vier in om de crypto-provider `pp_crypto_btcpay` te activeren.
# BTCPay is self-hosted: draai eerst je eigen instance (of test via testnet.demo.btcpayserver.org).
BTCPAY_URL=https://btcpay.example.com
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
# Per-webhook signing secret uit BTCPay (Store -> Settings -> Webhooks).
BTCPAY_WEBHOOK_SECRET=
# Storefront-origin voor de retour-URL na betalen.
STOREFRONT_URL=https://gradepurity.com

# ── Wallid hosted checkout ────────────────────────────────────────────────────
# Leeg laten = Wallid-provider wordt NIET geladen.
# Vul alle drie in om de provider `pp_card_wallid` te activeren.
# Webhook-URL voor Wallid: <backend>/hooks/payment/pp_card_wallid
# Het webhook-secret kiezen we zelf en geven we door aan Wallid (Lilik).
WALLID_API_URL=https://payment-api.wallid.co/api/payment-gw/v1
WALLID_KEY_ID=
WALLID_KEY_SECRET=
WALLID_WEBHOOK_SECRET=

# ── Transactionele e-mail (Resend) ────────────────────────────────────────────
# Leeg laten = notification-provider wordt NIET geladen (geen order-mails).
# Vul beide verplichte velden in om de Resend-provider te activeren.
# Maak een account op resend.com, verifieer het (sub)domein, genereer een API-key.
RESEND_API_KEY=
# Afzender MOET een geverifieerd (sub)domein zijn. Formaat: "Naam <adres>".
RESEND_FROM=GradePurity <orders@gradepurity.com>
# Optioneel: antwoorden komen hier binnen (je Google-inbox).
RESEND_REPLY_TO=info@gradepurity.com
